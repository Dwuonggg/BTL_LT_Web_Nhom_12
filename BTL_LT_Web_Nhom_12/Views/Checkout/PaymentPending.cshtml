
@model BTL_LT_Web_Nhom_12.Models.Order.Order

@{
    ViewData["Title"] = "Chờ thanh toán";
}

<section class="container py-5">

    <div class="row justify-content-center">
        <div class="col-lg-7">

            <div class="cart-summary text-center">

                <span class="eyebrow dark">
                    LỬA MỘC DELIVERY
                </span>

                <h1 class="mt-3">
                    Đơn hàng đã được tạo
                </h1>

                <p class="text-muted">
                    Mã đơn hàng:
                    <strong>#@Model.OrderId</strong>
                </p>

                @if (Model.Payment?.PaymentStatus == "Paid")
                {
                    <div class="alert alert-success">
                        Thanh toán đã được xác nhận.
                    </div>
                }
                else
                {
                    <div class="alert alert-warning">
                        Đơn hàng đang chờ thanh toán.
                    </div>
                }

                <div class="cart-summary-row mt-4">
                    <span>Người nhận</span>
                    <strong>@Model.ReceiverName</strong>
                </div>

                <div class="cart-summary-row">
                    <span>Số điện thoại</span>
                    <strong>@Model.ReceiverPhone</strong>
                </div>

                <div class="cart-summary-row">
                    <span>Tổng tiền</span>
                    <strong>
                        @Model.TotalAmount.ToString("N0") đ
                    </strong>
                </div>

                <div class="cart-summary-row">
                    <span>Trạng thái đơn</span>
                    <strong>@Model.Status</strong>
                </div>

                <hr />

                @if (Model.Payment?.PaymentStatus != "Paid" &&
                     Model.Status == "Pending" &&
                     Environment.GetEnvironmentVariable("ASPNETCORE_ENVIRONMENT") == "Development")
                {
                    <p class="text-muted">
                        Đơn hàng đang chờ thanh toán.
                        Vui lòng hoàn tất trong vòng 10 phút kể từ khi đặt.
                    </p>

                    <a asp-area=""
                       asp-controller="DemoPayment"
                       asp-action="Index"
                       asp-route-id="@Model.OrderId"
                       class="btn btn-brand w-100 mt-3">
                        Thanh toán bằng QR
                    </a>
                }

                <a asp-area=""
                   asp-controller="Home"
                   asp-action="Index"
                   class="btn btn-brand mt-3">
                    Về trang chủ
                </a>

            </div>

        </div>
    </div>

</section>

@section Styles {
    <link rel="stylesheet"
          href="~/css/cart.css"
          asp-append-version="true" />
}
