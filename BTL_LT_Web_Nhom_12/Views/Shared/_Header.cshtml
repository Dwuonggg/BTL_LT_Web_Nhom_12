
@{
    bool isCustomer = User.Identity?.IsAuthenticated == true
                      && User.IsInRole("Customer");
}

<header class="site-header">
    <nav class="navbar navbar-expand-lg container py-3">

        <!-- Logo -->
        <a class="navbar-brand brand"
           asp-area=""
           asp-controller="Home"
           asp-action="Index">
            LỬA MỘC
        </a>

        <!-- Menu trên điện thoại -->
        <button class="navbar-toggler"
                type="button"
                data-bs-toggle="collapse"
                data-bs-target="#mainNav"
                aria-controls="mainNav"
                aria-expanded="false"
                aria-label="Mở menu">
            Menu
        </button>

        <div class="collapse navbar-collapse" id="mainNav">

            <!-- Điều hướng -->
            <ul class="navbar-nav mx-auto">

                <li class="nav-item">
                    <a class="nav-link"
                       asp-area=""
                       asp-controller="Home"
                       asp-action="Index">
                        Trang chủ
                    </a>
                </li>

                <li class="nav-item">
                    <a class="nav-link"
                       asp-area=""
                       asp-controller="Menu"
                       asp-action="Index">
                        Thực đơn
                    </a>
                </li>

                <li class="nav-item">
                    <a class="nav-link"
                       asp-area=""
                       asp-controller="Combo"
                       asp-action="Index">
                        Combo
                    </a>
                </li>

                <li class="nav-item">
                    <a class="nav-link"
                       asp-area=""
                       asp-controller="Promotion"
                       asp-action="Index">
                        Ưu đãi
                    </a>
                </li>

                <li class="nav-item">
                    <a class="nav-link"
                       asp-area=""
                       asp-controller="Order"
                       asp-action="Index">
                        Đơn hàng
                    </a>
                </li>

            </ul>

            <!-- Giỏ hàng và tài khoản -->
            <div class="nav-actions">

                <a class="cart-link"
                   asp-area=""
                   asp-controller="Cart"
                   asp-action="Index">
                    Giỏ hàng (<span id="cart-count">0</span>)
                </a>

                @if (isCustomer)
                {
                    <!-- Tài khoản -->
                    <a class="btn btn-outline-brand btn-sm"
                       asp-area=""
                       asp-controller="Account"
                       asp-action="Profile">
                        Tài khoản
                    </a>

                    <!-- Đăng xuất có xác nhận -->
                    <form asp-area=""
                          asp-controller="Account"
                          asp-action="Logout"
                          method="post"
                          class="m-0"
                          onsubmit="return confirm('Bạn có chắc chắn muốn đăng xuất khỏi LỬA MỘC?');">

                        @Html.AntiForgeryToken()

                        <button type="submit"
                                class="btn btn-brand btn-sm">
                            Đăng xuất
                        </button>
                    </form>
                }
                else
                {
                    <a class="btn btn-outline-brand btn-sm"
                       asp-area=""
                       asp-controller="Account"
                       asp-action="Login">
                        Đăng nhập
                    </a>

                    <a class="btn btn-brand btn-sm"
                       asp-area=""
                       asp-controller="Account"
                       asp-action="Register">
                        Đăng ký
                    </a>
                }

            </div>
        </div>
    </nav>
</header>
