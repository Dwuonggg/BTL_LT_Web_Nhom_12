
@model List<BTL_LT_Web_Nhom_12.Models.Menu.Combo>

@{
    ViewData["Title"] = "Combo LỬA MỘC";
}

<section class="container py-5">

    <!-- TIÊU ĐỀ -->
    <div class="text-center mb-5">
        <span class="eyebrow dark">
            LỬA MỘC
        </span>

        <h1 class="mt-3 fw-bold">
            Combo hấp dẫn
        </h1>

        <p class="text-muted">
            Những combo được lựa chọn dành cho
            bữa ăn trọn vẹn và tiết kiệm.
        </p>
    </div>

    @if (TempData["CartError"] != null)
    {
        <div class="alert alert-danger">
            @TempData["CartError"]
        </div>
    }

    @if (TempData["CartMessage"] != null)
    {
        <div class="alert alert-success">
            @TempData["CartMessage"]
        </div>
    }

    @if (!Model.Any())
    {
        <div class="text-center py-5
                    border rounded-3 bg-white">

            <h4>Chưa có Combo nào</h4>

            <p class="text-muted">
                LỬA MỘC đang cập nhật các Combo mới.
            </p>

            <a asp-controller="Menu"
               asp-action="Index"
               class="btn btn-brand">
                Xem thực đơn
            </a>

        </div>
    }
    else
    {
        <div class="row g-4">

            @foreach (var combo in Model)
            {
                <div class="col-md-6 col-lg-4">

                    <div class="card h-100 border-0 shadow-sm
                                overflow-hidden">

                        <!-- HÌNH ẢNH -->
                        @if (!string.IsNullOrWhiteSpace(combo.ImageUrl))
                        {
                            <img src="@combo.ImageUrl"
                                 alt="@combo.Name"
                                 class="card-img-top"
                                 style="height:230px;
                                        object-fit:cover;" />
                        }
                        else
                        {
                            <div class="d-flex align-items-center
                                        justify-content-center bg-light"
                                 style="height:230px;">
                                <span class="text-muted">
                                    Chưa có hình ảnh
                                </span>
                            </div>
                        }

                        <div class="card-body d-flex flex-column p-4">

                            <!-- TÊN COMBO -->
                            <h4 class="fw-bold mb-2">
                                @combo.Name
                            </h4>

                            <!-- MÔ TẢ -->
                            <p class="text-muted mb-3">
                                @(string.IsNullOrWhiteSpace(combo.Description)
                                    ? "Combo đặc biệt của LỬA MỘC."
                                    : combo.Description)
                            </p>

                            <div class="mt-auto">

                                <!-- GIÁ BÁN -->
                                <h4 class="fw-bold text-danger mb-3">
                                    @combo.Price.ToString("N0") đ
                                </h4>

                                <!-- THÊM VÀO GIỎ HÀNG -->
                                <form asp-area=""
                                      asp-controller="Cart"
                                      asp-action="Add"
                                      method="post">

                                    @Html.AntiForgeryToken()

                                    <input type="hidden"
                                           name="type"
                                           value="Combo" />

                                    <input type="hidden"
                                           name="id"
                                           value="@combo.ComboId" />

                                    <input type="hidden"
                                           name="quantity"
                                           value="1" />
                                    <a asp-area=""
                                       asp-controller="Combo"
                                       asp-action="Details"
                                       asp-route-id="@combo.ComboId"
                                       class="btn btn-outline-brand w-100 mb-2">
                                        Xem chi tiết
                                    </a>
                                    <button type="submit"
                                            class="btn btn-brand w-100">
                                        Thêm vào giỏ hàng
                                    </button>

                                </form>

                            </div>

                        </div>
                    </div>

                </div>
            }

        </div>
    }

</section>
