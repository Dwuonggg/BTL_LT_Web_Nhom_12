
@model BTL_LT_Web_Nhom_12.ViewModels.VerifyOtpViewModel

@{
    ViewData["Title"] = "Xác minh OTP";
}

<section class="auth-wrap">
    <div class="auth-card">

        <span class="eyebrow dark">
            XÁC MINH TÀI KHOẢN
        </span>

        <h1>Nhập mã OTP</h1>

        <p class="auth-description">
            Nhập mã OTP gồm 6 chữ số.
            Mã có hiệu lực trong 5 phút.
        </p>

        @if (TempData["OtpInfo"] != null)
        {
            <div class="alert alert-info mb-3">
                @TempData["OtpInfo"]
            </div>
        }

        <!-- FORM XÁC MINH OTP -->
        <form asp-area=""
              asp-controller="Account"
              asp-action="VerifyOtp"
              method="post">

            @Html.AntiForgeryToken()

            <div asp-validation-summary="ModelOnly"
                 class="text-danger mb-3"></div>

            <div class="mb-4">
                <label asp-for="Code"
                       class="form-label">
                    Mã OTP
                </label>

                <input asp-for="Code"
                       type="text"
                       class="form-control"
                       placeholder="Nhập mã OTP"
                       maxlength="6"
                       inputmode="numeric"
                       pattern="[0-9]{6}"
                       autocomplete="one-time-code" />

                <span asp-validation-for="Code"
                      class="text-danger"></span>
            </div>

            <button type="submit"
                    class="btn btn-brand w-100">
                Xác minh
            </button>
        </form>

        <!-- FORM YÊU CẦU OTP MỚI -->
        <form asp-area=""
              asp-controller="Account"
              asp-action="ResendOtp"
              method="post"
              class="mt-3">

            @Html.AntiForgeryToken()

            <button type="submit"
                    class="btn btn-outline-brand w-100"
                    id="resendOtpBtn">
                Gửi lại mã OTP
            </button>
        </form>

        <p class="auth-switch text-center mt-3">
            Muốn dùng số điện thoại khác?

            <a asp-area=""
               asp-controller="Account"
               asp-action="ForgotPassword">
                Quay lại
            </a>
        </p>

    </div>
</section>

@section Styles {
    <link rel="stylesheet"
          href="~/css/account.css"
          asp-append-version="true" />
}

<script>
document.addEventListener("DOMContentLoaded", function () {

    const resendButton =
        document.getElementById("resendOtpBtn");

    if (!resendButton) return;

    const resendForm = resendButton.closest("form");

    resendForm.addEventListener("submit", function () {

        // Chặn bấm nhiều lần khi đang gửi request.
        resendButton.disabled = true;
        resendButton.textContent = "Đang yêu cầu mã mới...";
    });
});
</script>
