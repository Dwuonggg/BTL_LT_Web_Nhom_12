
@model BTL_LT_Web_Nhom_12.Models.Account.Customer

@{
    ViewData["Title"] = "Tài khoản của tôi";
}

<section class="section container">

    <div class="profile-container">

        <span class="eyebrow dark">
            TÀI KHOẢN LỬA MỘC
        </span>

        <h1 class="mb-4">Thông tin tài khoản</h1>

        <div class="profile-card">

            <h4>Thông tin cá nhân</h4>

            <div class="profile-info">
                <span>Họ và tên</span>
                <strong>@Model.FullName</strong>
            </div>

            <div class="profile-info">
                <span>Số điện thoại</span>
                <strong>@Model.Phone</strong>
            </div>

            <div class="profile-info">
                <span>Ngày đăng ký</span>
                <strong>
                    @Model.CreatedAt.ToString("dd/MM/yyyy")
                </strong>
            </div>

            <div class="profile-info">
                <span>Trạng thái tài khoản</span>
                <strong>
                    @(Model.IsActive ? "Đang hoạt động" : "Ngừng hoạt động")
                </strong>
            </div>

            <hr />

            <h4 class="mt-4">Quản lý đơn hàng</h4>

            <p class="text-muted">
                Xem lịch sử mua hàng và theo dõi
                trạng thái giao hàng của bạn.
            </p>

            <a asp-area=""
               asp-controller="Order"
               asp-action="Index"
               class="btn btn-brand">
                Đơn hàng của tôi
            </a>

        </div>

    </div>

</section>

@section Styles {
    <link rel="stylesheet"
          href="~/css/account.css"
          asp-append-version="true" />
}
