@model BTL_LT_Web_Nhom_12.ViewModels.LoginViewModels

@{
    ViewData["Title"] = "Đăng nhập";
}

<section class="auth-wrap">
    <div class="auth-card">

        <span class="eyebrow dark">
            CHÀO MỪNG TRỞ LẠI
        </span>

        <h1>Đăng nhập</h1>

        <p class="auth-description">
            Đăng nhập để đặt món và theo dõi
            đơn hàng tại LỬA MỘC.
        </p>

        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success mb-3">
                @TempData["SuccessMessage"]
            </div>
        }

        <form asp-area=""
              asp-controller="Account"
              asp-action="Login"
              method="post">

            @Html.AntiForgeryToken()

            <div asp-validation-summary="ModelOnly"
                 class="text-danger mb-3">
            </div>

            <div class="mb-3">
                <label asp-for="UsernameOrPhone"
                       class="form-label">
                    Tên đăng nhập hoặc số điện thoại
                </label>

                <input asp-for="UsernameOrPhone"
                       class="form-control"
                       placeholder="Nhập tài khoản hoặc số điện thoại"
                       autocomplete="username" />

                <span asp-validation-for="UsernameOrPhone"
                      class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Password"
                       class="form-label">
                    Mật khẩu
                </label>

                <div class="password-field">
                    <input asp-for="Password"
                           type="password"
                           class="form-control"
                           placeholder="Nhập mật khẩu"
                           autocomplete="current-password"
                           value="" />

                    <button type="button"
                            class="password-toggle"
                            id="togglePassword">
                        Hiện
                    </button>
                </div>

                <span asp-validation-for="Password"
                      class="text-danger"></span>

                <div class="text-end mt-2 mb-3">
                    <a asp-area=""
                       asp-controller="Account"
                       asp-action="ForgotPassword"
                       class="forgot-password">
                        Quên mật khẩu?
                    </a>
                </div>
            </div>

            <div class="form-check mb-4">
                <input asp-for="RememberMe"
                       class="form-check-input" />

                <label asp-for="RememberMe"
                       class="form-check-label">
                    Ghi nhớ đăng nhập
                </label>
            </div>

            <button type="submit"
                    class="btn btn-brand w-100">
                Đăng nhập
            </button>

            <p class="auth-switch">
                Chưa có tài khoản?

                <a asp-area=""
                   asp-controller="Account"
                   asp-action="Register">
                    Đăng ký ngay
                </a>
            </p>

        </form>
    </div>
</section>

@section Styles {
    <link rel="stylesheet"
          href="~/css/account.css"
          asp-append-version="true" />
}

@section Scripts {
    <script>
        const togglePassword = document.getElementById("togglePassword");
        const passwordInput = document.getElementById("Password");

        if (togglePassword && passwordInput) {
            togglePassword.addEventListener("click", function () {
                const isHidden = passwordInput.type === "password";

                passwordInput.type = isHidden ? "text" : "password";
                this.textContent = isHidden ? "Ẩn" : "Hiện";
            });
        }
    </script>
}
