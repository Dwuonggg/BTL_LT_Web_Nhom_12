@model BTL_LT_Web_Nhom_12.ViewModels.ForgotPasswordViewModel

@{
    ViewData["Title"] = "Quên mật khẩu";
}

<section class="auth-wrap">
    <div class="auth-card">

        <span class="eyebrow dark">
            KHÔI PHỤC TÀI KHOẢN
        </span>

        <h1>Quên mật khẩu</h1>

        <p class="auth-description">
            Nhập số điện thoại đã đăng ký tài khoản
            tại LỬA MỘC để nhận mã xác minh.
        </p>

        <form asp-area=""
              asp-controller="Account"
              asp-action="ForgotPassword"
              method="post">

            @Html.AntiForgeryToken()

            <div asp-validation-summary="ModelOnly"
                 class="text-danger mb-3"></div>

            <div class="mb-4">
                <label asp-for="Phone" class="form-label">
                    Số điện thoại
                </label>

                <input asp-for="Phone"
                       type="tel"
                       class="form-control"
                       placeholder="Nhập số điện thoại"
                       maxlength="10"
                       autocomplete="tel" />

                <span asp-validation-for="Phone"
                      class="text-danger"></span>
            </div>

            <button type="submit"
                    class="btn btn-brand w-100">
                Gửi mã xác minh
            </button>

            <p class="auth-switch">
                <a asp-area=""
                   asp-controller="Account"
                   asp-action="Login">
                    Quay lại đăng nhập
                </a>
            </p>
        </form>
    </div>
</section>

@section Styles {
    <link rel="stylesheet"
          href="~/css/account.css"
          asp-append-version="true" />
}
