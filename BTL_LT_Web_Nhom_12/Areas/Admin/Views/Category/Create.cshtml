@model BTL_LT_Web_Nhom_12.Models.Menu.Category

@{
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Thêm danh mục";
}

<div class="card border-0 shadow-sm rounded-3 p-4">
    <h5 class="fw-bold mb-4">Thêm danh mục món ăn</h5>

    <form asp-area="Admin"
          asp-controller="Category"
          asp-action="Create"
          method="post"
         enctype="multipart/form-data">

        @Html.AntiForgeryToken()

        <div asp-validation-summary="ModelOnly"
             class="text-danger"></div>

        <div class="mb-3">
            <label asp-for="Name" class="form-label">
                Tên danh mục
            </label>
            <input asp-for="Name" class="form-control"
                   placeholder="Nhập tên danh mục" />
            <span asp-validation-for="Name"
                  class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Description" class="form-label">
                Mô tả
            </label>
            <textarea asp-for="Description"
                      class="form-control" rows="3"></textarea>
            <span asp-validation-for="Description"
                  class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label class="form-label">Hình ảnh danh mục</label>
            <input type="file"
                   name="imageFile"
                   class="form-control"
                   accept=".jpg,.jpeg,.png,.webp" />
        </div>
        <span class="text-danger">
            @Html.ValidationMessage("imageFile")
        </span>

        <div class="form-check mb-3">
            <input asp-for="IsActive" class="form-check-input" />
            <label asp-for="IsActive" class="form-check-label">
                Đang hoạt động
            </label>
        </div>

        <button type="submit" class="btn btn-danger">
            Lưu danh mục
        </button>

        <a asp-area="Admin"
           asp-controller="Category"
           asp-action="Index"
           class="btn btn-secondary">
            Quay lại
        </a>
    </form>
</div>
