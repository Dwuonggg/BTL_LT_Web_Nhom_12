@model BTL_LT_Web_Nhom_12.Models.Menu.Category

@{
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Sửa danh mục";
}

<div class="card border-0 shadow-sm rounded-3 p-4">
    <h5 class="fw-bold mb-4">Sửa danh mục món ăn</h5>

    <form asp-area="Admin"
          asp-controller="Category"
          asp-action="Edit"
          asp-route-id="@Model.CategoryId"
          method="post"
          enctype="multipart/form-data">

        @Html.AntiForgeryToken()

        <input type="hidden" asp-for="CategoryId" />

        <div asp-validation-summary="ModelOnly"
             class="text-danger mb-3"></div>

        <div class="mb-3">
            <label asp-for="Name" class="form-label">
                Tên danh mục
            </label>
            <input asp-for="Name" class="form-control" />
            <span asp-validation-for="Name" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Description" class="form-label">
                Mô tả
            </label>
            <textarea asp-for="Description"
                      class="form-control"
                      rows="3"></textarea>
            <span asp-validation-for="Description"
                  class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label class="form-label">Hình ảnh danh mục</label>

            @if (!string.IsNullOrWhiteSpace(Model.ImageUrl))
            {
                <div class="mb-2">
                    <img src="@Model.ImageUrl"
                         alt="@Model.Name"
                         style="width:100px;
                    height:100px;
                    object-fit:cover;
                    border-radius:8px;" />
                </div>
            }

            <input type="file"
                   name="imageFile"
                   class="form-control"
                   accept=".jpg,.jpeg,.png,.webp" />

            <small class="text-muted">
                Không chọn ảnh mới nếu muốn giữ ảnh hiện tại.
            </small>

            <div class="text-danger">
                @Html.ValidationMessage("imageFile")
            </div>
        </div>

        <div class="form-check mb-3">
            <input asp-for="IsActive" class="form-check-input" />
            <label asp-for="IsActive" class="form-check-label">
                Đang hoạt động
            </label>
        </div>

        <button type="submit" class="btn btn-danger">
            Lưu thay đổi
        </button>

        <a asp-area="Admin"
           asp-controller="Category"
           asp-action="Index"
           class="btn btn-secondary">
            Quay lại
        </a>
    </form>
</div>
