
@model List<BTL_LT_Web_Nhom_12.Models.Order.Order>

@{
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Quản lý đơn hàng";

    string search = ViewBag.Search as string ?? "";
    string status = ViewBag.Status as string ?? "";
}

<div class="card border-0 shadow-sm rounded-3 p-4">

    <!-- TIÊU ĐỀ VÀ BỘ LỌC -->
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">

        <h5 class="fw-bold mb-0">
            Quản lý đơn hàng
        </h5>

        <form asp-area="Admin"
              asp-controller="Order"
              asp-action="Index"
              method="get"
              class="d-flex flex-wrap gap-2">

            <input type="text"
                   name="search"
                   value="@search"
                   class="form-control form-control-sm"
                   placeholder="Mã đơn, tên, SĐT..."
                   style="width:220px" />

            <select name="status"
                    class="form-select form-select-sm"
                    style="width:170px">

                <option value="">Tất cả trạng thái</option>

                <option value="Pending"
                        selected="@(status == "Pending")">
                    Chờ chuẩn bị
                </option>

                <option value="Preparing"
                        selected="@(status == "Preparing")">
                    Đang chuẩn bị
                </option>

                <option value="Delivering"
                        selected="@(status == "Delivering")">
                    Đang giao
                </option>

                <option value="Delivered"
                        selected="@(status == "Delivered")">
                    Hoàn thành
                </option>

                <option value="Cancelled"
                        selected="@(status == "Cancelled")">
                    Đã hủy
                </option>
            </select>

            <button type="submit"
                    class="btn btn-sm btn-danger">
                Tìm kiếm
            </button>

            <a asp-area="Admin"
               asp-controller="Order"
               asp-action="Index"
               class="btn btn-sm btn-outline-secondary">
                Đặt lại
            </a>

        </form>
    </div>

    <!-- THÔNG BÁO -->
    <div id="orderMessage"
         class="alert d-none"
         role="alert">
    </div>

    <!-- DANH SÁCH ĐƠN HÀNG -->
    <div class="table-responsive">

        <table class="table table-hover align-middle">

            <thead class="table-light">
                <tr>
                    <th>Mã đơn</th>
                    <th>Khách hàng</th>
                    <th>Số điện thoại</th>
                    <th>Ngày đặt</th>
                    <th>Tổng tiền</th>
                    <th>Thanh toán</th>
                    <th>Trạng thái đơn</th>
                    <th class="text-end">Thao tác</th>
                </tr>
            </thead>

            <tbody id="orderTableBody">

                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="8"
                            class="text-center text-muted py-4">
                            Không có đơn hàng phù hợp.
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var order in Model)
                    {
                        bool isPaid =
                            order.Payment?.PaymentStatus == "Paid";

                        // TRẠNG THÁI ĐƠN HÀNG
                        string statusText = order.Status switch
                        {
                            "Pending" => isPaid
                                ? "Chờ chuẩn bị"
                                : "Chờ thanh toán",

                            "Preparing" => "Đang chuẩn bị",
                            "Delivering" => "Đang giao",
                            "Delivered" => "Hoàn thành",
                            "Cancelled" => "Đã hủy",
                            _ => order.Status
                        };

                        string statusClass = order.Status switch
                        {
                            "Pending" => "bg-warning text-dark",
                            "Preparing" => "bg-primary",
                            "Delivering" => "bg-info text-dark",
                            "Delivered" => "bg-success",
                            "Cancelled" => "bg-secondary",
                            _ => "bg-secondary"
                        };

                        // TRẠNG THÁI THANH TOÁN
                        string paymentText =
                            order.Payment?.PaymentStatus switch
                            {
                                "Pending" => "Chờ thanh toán",
                                "Paid" => "Đã thanh toán",
                                "Failed" => "Thất bại",
                                "Cancelled" => "Đã hủy",
                                "Refunded" => "Đã hoàn tiền",
                                _ => "Chưa có giao dịch"
                            };

                        string paymentClass =
                            order.Payment?.PaymentStatus switch
                            {
                                "Pending" => "bg-warning text-dark",
                                "Paid" => "bg-success",
                                "Failed" => "bg-danger",
                                "Cancelled" => "bg-secondary",
                                "Refunded" => "bg-info text-dark",
                                _ => "bg-secondary"
                            };

                        <tr data-order-id="@order.OrderId">

                            <!-- MÃ ĐƠN -->
                            <td>
                                <strong>#@order.OrderId</strong>
                            </td>

                            <!-- KHÁCH HÀNG -->
                            <td>@order.ReceiverName</td>

                            <!-- SỐ ĐIỆN THOẠI -->
                            <td>@order.ReceiverPhone</td>

                            <!-- NGÀY ĐẶT -->
                            <td>
                                @order.OrderDate.ToString("dd/MM/yyyy HH:mm")
                            </td>

                            <!-- TỔNG TIỀN -->
                            <td class="fw-bold text-danger">
                                @order.TotalAmount.ToString("N0")đ
                            </td>

                            <!-- THANH TOÁN -->
                            <td>
                                <span class="badge @paymentClass">
                                    @paymentText
                                </span>
                            </td>

                            <!-- TRẠNG THÁI -->
                            <td>
                                <span class="badge order-status @statusClass">
                                    @statusText
                                </span>
                            </td>

                            <!-- THAO TÁC -->
                            <td class="text-end">

                                <div class="d-flex flex-wrap justify-content-end gap-1">

                                    <a asp-area="Admin"
                                       asp-controller="Order"
                                       asp-action="Details"
                                       asp-route-id="@order.OrderId"
                                       class="btn btn-sm btn-outline-dark">
                                        Chi tiết
                                    </a>

                                    @* Đã thanh toán: bắt đầu chuẩn bị *@
                                    @if (isPaid && order.Status == "Pending")
                                    {
                                        <button type="button"
                                                class="btn btn-sm btn-warning order-update"
                                                data-id="@order.OrderId"
                                                data-next="Preparing">
                                            Bắt đầu chuẩn bị
                                        </button>
                                    }

                                    @* Chuẩn bị xong: bàn giao vận chuyển *@
                                    @if (isPaid && order.Status == "Preparing")
                                    {
                                        <button type="button"
                                                class="btn btn-sm btn-primary order-update"
                                                data-id="@order.OrderId"
                                                data-next="Delivering">
                                            Giao hàng
                                        </button>
                                    }

                                    @* Delivering:
                                       Chỉ Customer được xác nhận đã nhận.
                                       Admin không có nút hoàn thành. *@

                                </div>

                            </td>
                        </tr>
                    }
                }

            </tbody>
        </table>
    </div>
</div>

<!-- ANTI-FORGERY TOKEN -->
<form id="orderAjaxToken" class="d-none">
    @Html.AntiForgeryToken()
</form>

<script>
document.addEventListener("DOMContentLoaded", function () {

    const tableBody = document.getElementById("orderTableBody");
    const messageBox = document.getElementById("orderMessage");

    const updateUrl =
        '@Url.Action("UpdateStatus", "Order", new { area = "Admin" })';

    const tokenInput = document.querySelector(
        '#orderAjaxToken input[name="__RequestVerificationToken"]'
    );

    if (!tableBody || !tokenInput) return;

    const token = tokenInput.value;

    function showMessage(text, success) {
        messageBox.className = success
            ? "alert alert-success"
            : "alert alert-danger";

        messageBox.textContent = text;
    }

    tableBody.addEventListener("click", async function (event) {

        const button = event.target.closest(".order-update");

        if (!button) return;

        const id = button.dataset.id;
        const newStatus = button.dataset.next;

        // KHÔNG HIỂN THỊ HỘP THOẠI CONFIRM
        button.disabled = true;

        try {
            const body = new URLSearchParams();

            body.append("id", id);
            body.append("newStatus", newStatus);
            body.append("__RequestVerificationToken", token);

            const response = await fetch(updateUrl, {
                method: "POST",
                body: body
            });

            const result = await response.json();

            if (!response.ok || !result.success) {
                throw new Error(
                    result.message || "Cập nhật trạng thái thất bại."
                );
            }

            // Thành công: tải lại để cập nhật
            // trạng thái và các nút thao tác.
            window.location.reload();

        } catch (error) {

            button.disabled = false;

            showMessage(
                error.message || "Có lỗi xảy ra.",
                false
            );
        }
    });
});
</script>
