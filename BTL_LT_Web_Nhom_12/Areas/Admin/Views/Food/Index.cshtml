@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Danh sách món ăn";
}

<div class="card border-0 shadow-sm rounded-3 p-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h5 class="fw-bold mb-0">Thực đơn món ăn</h5>
        <button class="btn btn-danger" data-bs-toggle="modal" data-bs-target="#addFoodModal">+ Thêm món mới</button>
    </div>

    <table class="table table-hover align-middle">
        <thead class="table-light">
            <tr>
                <th>Hình ảnh</th>
                <th>Tên món</th>
                <th>Danh mục</th>
                <th>Giá bán</th>
                <th>Trạng thái</th>
                <th class="text-end">Thao tác</th>
            </tr>
        </thead>
        <tbody>
            <tr>
                <td><div style="width:50px; height:50px; background:#eee; border-radius:6px;" class="d-flex align-items-center justify-content-center text-muted small">Ảnh</div></td>
                <td><strong>Sườn Tảng Nướng BBQ</strong></td>
                <td>Sườn nướng</td>
                <td class="fw-bold">320.000đ</td>
                <td><span class="badge bg-success">Đang bán</span></td>
                <td class="text-end">
                    <button class="btn btn-sm btn-outline-dark me-1">Sửa</button>
                    <button class="btn btn-sm btn-outline-danger">Xóa</button>
                </td>
            </tr>
            <tr>
                <td><div style="width:50px; height:50px; background:#eee; border-radius:6px;" class="d-flex align-items-center justify-content-center text-muted small">Ảnh</div></td>
                <td><strong>Sườn Cây Sốt Cay</strong></td>
                <td>Sườn nướng</td>
                <td class="fw-bold">280.000đ</td>
                <td><span class="badge bg-success">Đang bán</span></td>
                <td class="text-end">
                    <button class="btn btn-sm btn-outline-dark me-1">Sửa</button>
                    <button class="btn btn-sm btn-outline-danger">Xóa</button>
                </td>
            </tr>
            <tr>
                <td><div style="width:50px; height:50px; background:#eee; border-radius:6px;" class="d-flex align-items-center justify-content-center text-muted small">Ảnh</div></td>
                <td><strong>Salad Nga</strong></td>
                <td>Món ăn kèm</td>
                <td class="fw-bold">45.000đ</td>
                <td><span class="badge bg-secondary">Hết hàng</span></td>
                <td class="text-end">
                    <button class="btn btn-sm btn-outline-dark me-1">Sửa</button>
                    <button class="btn btn-sm btn-outline-danger">Xóa</button>
                </td>
            </tr>
        </tbody>
    </table>
</div>

<!-- Modal Thêm món -->
<div class="modal fade" id="addFoodModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title fw-bold">Thêm món ăn mới</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label">Tên món ăn</label>
                        <input type="text" class="form-control" placeholder="Nhập tên món" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Danh mục</label>
                        <select class="form-select">
                            <option>Sườn nướng</option>
                            <option>Món ăn kèm</option>
                            <option>Đồ uống</option>
                        </select>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Giá bán (VNĐ)</label>
                        <input type="number" class="form-control" placeholder="320000" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Hình ảnh</label>
                        <input type="file" class="form-control" />
                    </div>
                    <div class="col-md-12">
                        <label class="form-label">Mô tả món ăn</label>
                        <textarea class="form-control" rows="3" placeholder="Nhập mô tả món ăn..."></textarea>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Hủy</button>
                <button type="button" class="btn btn-danger">Lưu món mới</button>
            </div>
        </div>
    </div>
</div>