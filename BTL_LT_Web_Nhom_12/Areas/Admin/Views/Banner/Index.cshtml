@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Banner Quảng Cáo";
}

<div class="card border-0 shadow-sm rounded-3 p-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h5 class="fw-bold mb-0">Quản lý Banner Trang Chủ</h5>
        <button class="btn btn-danger">+ Thêm Banner</button>
    </div>

    <table class="table table-hover align-middle">
        <thead class="table-light">
            <tr>
                <th>Tiêu đề Banner</th>
                <th>Hình ảnh</th>
                <th>Liên kết chỉ hướng</th>
                <th>Trạng thái</th>
                <th class="text-end">Thao tác</th>
            </tr>
        </thead>
        <tbody>
            <tr>
                <td><strong>Khuyến mãi Sườn Mười T10</strong></td>
                <td><div style="width:120px; height:50px; background:#eee; border-radius:4px;" class="d-flex align-items-center justify-content-center text-muted small">Banner 1</div></td>
                <td>/Promotion</td>
                <td><span class="badge bg-success">Hiển thị</span></td>
                <td class="text-end">
                    <button class="btn btn-sm btn-outline-dark me-1">Sửa</button>
                    <button class="btn btn-sm btn-outline-danger">Xóa</button>
                </td>
            </tr>
        </tbody>
    </table>
</div>