     tabindex="-1"
     aria-labelledby="editVoucherTitle"
     aria-hidden="true">

    <div class="modal-dialog modal-lg">
        <div class="modal-content">

            <form asp-area="Admin"
                  asp-controller="Voucher"
                  asp-action="Edit"
                  method="post">

                @Html.AntiForgeryToken()

                <input type="hidden"
                       name="id"
                       id="editVoucherId" />

                <div class="modal-header">
                    <h5 class="modal-title fw-bold"
                        id="editVoucherTitle">
                        Sửa mã giảm giá
                    </h5>

                    <button type="button"
                            class="btn-close"
                            data-bs-dismiss="modal"
                            aria-label="Đóng"></button>
                </div>

                <div class="modal-body">
                    <div class="row g-3">

                        <!-- MÃ -->
                        <div class="col-md-6">
                            <label class="form-label">
                                Mã Voucher
                            </label>

                            <input type="text"
                                   name="code"
                                   id="editVoucherCode"
                                   class="form-control"
                                   maxlength="50"
                                   required />
                        </div>

                        <!-- TÊN -->
                        <div class="col-md-6">
                            <label class="form-label">
                                Tên chương trình
                            </label>

                            <input type="text"
                                   name="title"
                                   id="editVoucherName"
                                   class="form-control"
                                   maxlength="150"
                                   required />
                        </div>

                        <!-- MÔ TẢ -->
                        <div class="col-12">
                            <label class="form-label">
                                Mô tả
                            </label>

                            <textarea name="description"
                                      id="editVoucherDescription"
                                      class="form-control"
                                      maxlength="500"
                                      rows="2"></textarea>
                        </div>

                        <!-- PHẦN TRĂM -->
                        <div class="col-md-4">
                            <label class="form-label">
                                Giảm (%)
                            </label>

                            <input type="number"
                                   name="discountPercent"
                                   id="editVoucherPercent"
                                   class="form-control"
                                   min="0.01"
                                   max="100"
                                   step="0.01"
                                   required />
                        </div>

                        <!-- GIẢM TỐI ĐA -->
                        <div class="col-md-4">
                            <label class="form-label">
                                Giảm tối đa (đ)
                            </label>

                            <input type="number"
                                   name="maxDiscountAmount"
                                   id="editVoucherMax"
                                   class="form-control"
                                   min="1"
                                   step="1"
                                   required />
                        </div>

                        <!-- ĐƠN TỐI THIỂU -->
                        <div class="col-md-4">
                            <label class="form-label">
                                Đơn tối thiểu (đ)
                            </label>

                            <input type="number"
                                   name="minOrderAmount"
                                   id="editVoucherMin"
                                   class="form-control"
                                   min="0"
                                   step="1"
                                   required />
                        </div>

                        <!-- NGÀY BẮT ĐẦU -->
                        <div class="col-md-6">
                            <label class="form-label">
                                Ngày bắt đầu
                            </label>

                            <input type="datetime-local"
                                   name="startDate"
                                   id="editVoucherStart"
                                   class="form-control"
                                   required />
                        </div>

                        <!-- NGÀY KẾT THÚC -->
                        <div class="col-md-6">
                            <label class="form-label">
                                Ngày kết thúc
                            </label>

                            <input type="datetime-local"
                                   name="endDate"
                                   id="editVoucherEnd"
                                   class="form-control"
                                   required />
                        </div>

                        <!-- KÍCH HOẠT -->
                        <div class="col-12">
                            <div class="form-check">
                                <input type="checkbox"
                                       name="isActive"
                                       value="true"
                                       id="editVoucherActive"
                                       class="form-check-input" />

                                <label for="editVoucherActive"
                                       class="form-check-label">
                                    Kích hoạt Voucher
                                </label>
                            </div>
                        </div>

                    </div>
                </div>

                <div class="modal-footer">
                    <button type="button"
                            class="btn btn-secondary"
                            data-bs-dismiss="modal">
                        Hủy
                    </button>

                    <button type="submit"
                            class="btn btn-danger">
                        Lưu thay đổi
                    </button>
                </div>

            </form>
        </div>
    </div>
</div>


<!-- TOKEN SỬ DỤNG CHO AJAX -->
<form id="voucherAjaxToken" class="d-none">
    @Html.AntiForgeryToken()
</form>

<script>
document.addEventListener("DOMContentLoaded", function () {

    document.querySelectorAll(".edit-voucher").forEach(button => {

        button.addEventListener("click", function () {

            document.getElementById("editVoucherId").value =
                this.dataset.id;

            document.getElementById("editVoucherCode").value =
                this.dataset.code;

            document.getElementById("editVoucherName").value =
                this.dataset.title;

            document.getElementById("editVoucherDescription").value =
                this.dataset.description || "";

            document.getElementById("editVoucherPercent").value =
                this.dataset.percent;

            document.getElementById("editVoucherMax").value =
                this.dataset.max;

            document.getElementById("editVoucherMin").value =
                this.dataset.min;

            document.getElementById("editVoucherStart").value =
                this.dataset.start;

            document.getElementById("editVoucherEnd").value =
                this.dataset.end;

            document.getElementById("editVoucherActive").checked =
                this.dataset.active === "true";
        });
    });

    document.querySelectorAll(".voucher-toggle").forEach(button => {

        button.addEventListener("click", async function () {

            const oldText = this.textContent;

            this.disabled = true;
            this.textContent = "Đang lưu...";

            try {

                const token = document.querySelector(
                    '#voucherAjaxToken input[name="__RequestVerificationToken"]'
                ).value;

                const body = new URLSearchParams();

                body.append("id", this.dataset.id);
                body.append("__RequestVerificationToken", token);

                const response = await fetch(this.dataset.url, {
                    method: "POST",
                    body: body
                });

                const result = await response.json();

                if (!response.ok || !result.success) {
                    throw new Error(
                        result.message || "Không thể cập nhật Voucher."
                    );
                }

                const now = new Date();
                const start = new Date(this.dataset.start);
                const end = new Date(this.dataset.end);

                let statusText = "";
                let isUsable = false;

                if (!result.isActive) {
                    statusText = "Đã tắt";
                }
                else if (now < start) {
                    statusText = "Chưa bắt đầu";
                }
                else if (now > end) {
                    statusText = "Hết hạn";
                }
                else {
                    statusText = "Đang hoạt động";
                    isUsable = true;
                }

                this.textContent = statusText;

                this.classList.toggle(
                    "btn-success", isUsable
                );

                this.classList.toggle(
                    "btn-secondary", !isUsable
                );

                // Đồng bộ trạng thái với Modal Sửa
                const editButton = this.closest("tr")
                    .querySelector(".edit-voucher");

                if (editButton) {
                    editButton.dataset.active =
                        result.isActive ? "true" : "false";
                }

                const message = document.getElementById(
                    "voucherMessage"
                );

                message.className = "alert alert-success";
                message.textContent = result.message;

            }
            catch (error) {

                this.textContent = oldText;

                const message = document.getElementById(
                    "voucherMessage"
                );

                message.className = "alert alert-danger";
                message.textContent = error.message;
            }
            finally {
                this.disabled = false;
            }
        });
    });

});
</script>
